  classDef inputBox fill:#f0fdf4,stroke:#16a34a,stroke-width:1.5px,color:#0f172a;
  classDef methodBox fill:#fefce8,stroke:#ca8a04,stroke-width:1.5px,color:#0f172a;
  classDef outBox fill:#f3e8ff,stroke:#7e22ce,stroke-width:1.5px,color:#0f172a;
  classDef evalBox fill:#fff1f2,stroke:#e11d48,stroke-width:2px,color:#0f172a;

  class G1,G2,G3,G4,G5 sourceBox;
  class B_ORG,B_TASKS,B_GOV benchBox;
  class R_IN,R_IDX inputBox;
  class M_PLAN,M_PRE,M_POST,M_GUARD methodBox;
  class P_OUT outBox;
  class E_REF,E_SCORER evalBox;
